{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}"
    },
    {
      "name": "dev",
      "displayName": "Dev (Debug, warnings as errors)",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "ARCADE_WERROR": "ON" }
    },
    {
      "name": "release",
      "displayName": "Release",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "ARCADE_WERROR": "ON" }
    },
    {
      "name": "logic",
      "displayName": "Logic only (no raylib, no download, fastest)",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "ARCADE_WERROR": "ON", "ARCADE_LOGIC_ONLY": "ON" }
    },
    {
      "name": "headless",
      "displayName": "Headless (raylib CPU renderer, for smoke tests)",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "ARCADE_WERROR": "ON", "ARCADE_HEADLESS": "ON" }
    },
    {
      "name": "android-arm64",
      "displayName": "Android arm64-v8a (the NDK, r28 or newer: set ANDROID_NDK_HOME; see docs/ANDROID.md)",
      "inherits": "base",
      "toolchainFile": "$env{ANDROID_NDK_HOME}/build/cmake/android.toolchain.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ANDROID_ABI": "arm64-v8a",
        "ANDROID_PLATFORM": "android-26",
        "ARCADE_BUILD_TESTS": "OFF",
        "ARCADE_ONLINE": "OFF",
        "ARCADE_WERROR": "OFF"
      }
    },
    {
      "name": "asan",
      "displayName": "Logic only + AddressSanitizer/UBSan (Linux/macOS)",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "ARCADE_WERROR": "ON", "ARCADE_LOGIC_ONLY": "ON", "ARCADE_SANITIZE": "ON" },
      "condition": { "type": "notEquals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    }
  ],
  "buildPresets": [
    { "name": "dev", "configurePreset": "dev" },
    { "name": "release", "configurePreset": "release" },
    { "name": "logic", "configurePreset": "logic" },
    { "name": "headless", "configurePreset": "headless" },
    { "name": "android-arm64", "configurePreset": "android-arm64" },
    { "name": "asan", "configurePreset": "asan" }
  ],
  "testPresets": [
    { "name": "dev", "configurePreset": "dev", "output": { "outputOnFailure": true } },
    { "name": "release", "configurePreset": "release", "output": { "outputOnFailure": true } },
    { "name": "logic", "configurePreset": "logic", "output": { "outputOnFailure": true } },
    { "name": "headless", "configurePreset": "headless", "output": { "outputOnFailure": true } },
    { "name": "asan", "configurePreset": "asan", "output": { "outputOnFailure": true } }
  ]
}
