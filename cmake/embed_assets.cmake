# Turns every file of assets/ (plus a few legal texts from the repository root) into ONE C source file, so the
# game is a single executable that needs no files next to it. It is run at BUILD time by the custom command in
# cmake/ArcadeAssets.cmake, and only when one of those files changed:
#
#   cmake -DASSETS_DIR=<assets> -DROOT_DIR=<repo root> -DROOT_FILES=<a,b> -DOUT=<file.c> -P embed_assets.cmake
#
# The generated file defines the two tables declared in core/include/arcade/assets.h:
#   g_arcade_assets[]       { name, data, size }   name = path inside assets/ ("fonts/PoiretOne-Regular.ttf")
#   g_arcade_asset_count                           or the file name for the root files ("LICENSE")
# Each file is a byte array followed by ONE extra 0x00 that .size does not count, so a text asset can be used as a
# C string. (A hex byte array, not a string literal: C99 only guarantees string literals of 4095 characters.)
foreach(_var ASSETS_DIR ROOT_DIR OUT)
  if(NOT DEFINED ${_var})
    message(FATAL_ERROR "embed_assets.cmake: -D${_var}=... is missing")
  endif()
endforeach()

file(GLOB_RECURSE _found RELATIVE "${ASSETS_DIR}" "${ASSETS_DIR}/*")
list(SORT _found) # the same order on every machine: reproducible output

set(_names "")
set(_paths "")
foreach(_f IN LISTS _found)
  list(APPEND _names "${_f}")
  list(APPEND _paths "${ASSETS_DIR}/${_f}")
endforeach()
string(REPLACE "," ";" _root_files "${ROOT_FILES}") # a list cannot be passed through -D, so "," stands for ";"
foreach(_f IN LISTS _root_files)
  list(APPEND _names "${_f}")
  list(APPEND _paths "${ROOT_DIR}/${_f}")
endforeach()

# 16 bytes per line: the regex below cuts the hex text into lines of 32 hex digits
string(REPEAT "[0-9a-f]" 32 _line_pattern)

set(_arrays "")
set(_table "")
set(_i 0)
foreach(_name _path IN ZIP_LISTS _names _paths)
  if(NOT EXISTS "${_path}")
    message(FATAL_ERROR "embed_assets.cmake: ${_path} does not exist")
  endif()
  file(READ "${_path}" _hex HEX)
  string(REGEX REPLACE "(${_line_pattern})" "\\1\n" _hex "${_hex}")
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," _bytes "${_hex}")
  string(APPEND _arrays "/* ${_name} */\nstatic const unsigned char asset_${_i}[] = {\n${_bytes}\n0x00};\n\n")
  string(APPEND _table "    {\"${_name}\", asset_${_i}, sizeof(asset_${_i}) - 1},\n")
  math(EXPR _i "${_i} + 1")
endforeach()

file(WRITE "${OUT}" "/* Generated by cmake/embed_assets.cmake from assets/. Do not edit. */
#include \"arcade/assets.h\"

${_arrays}const ArcAssetEntry g_arcade_assets[] = {
${_table}};
const int g_arcade_asset_count = ${_i};
")
