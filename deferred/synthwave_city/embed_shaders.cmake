# Embeds shaders/*.glsl, *.vert and *.frag into <build>/swc_shaders.c as NUL-terminated byte arrays (a C99
# string literal may not be longer than 4095 characters, so text would not do) behind
#   const char *swc_shader_get(const char *name)    name = file name without its folder, e.g. "sky.frag"
# Runs at configure time; editing a shader re-runs CMake.
#
#   swc_embed_shaders(<output variable>)   sets the variable to the generated .c file
function(swc_embed_shaders out_var)
  file(GLOB _shaders CONFIGURE_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/shaders/*.glsl"
       "${CMAKE_CURRENT_SOURCE_DIR}/shaders/*.vert" "${CMAKE_CURRENT_SOURCE_DIR}/shaders/*.frag")
  list(SORT _shaders)
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${_shaders})
  set(_arrays "")
  set(_table "")
  set(_i 0)
  foreach(_f IN LISTS _shaders)
    get_filename_component(_name "${_f}" NAME)
    file(READ "${_f}" _hex HEX)
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," _bytes "${_hex}")
    string(APPEND _arrays "static const unsigned char swc_shader_${_i}[] = {${_bytes}0x00};\n")
    string(APPEND _table "    {\"${_name}\", (const char *)swc_shader_${_i}},\n")
    math(EXPR _i "${_i} + 1")
  endforeach()
  set(_c "/* Generated by embed_shaders.cmake from shaders/. Do not edit. */\n#include <string.h>\n#include \"swc_shaders.h\"\n\n${_arrays}\nstatic const struct {\n    const char *name;\n    const char *text;\n} swc_shader_table[] = {\n${_table}    {0, 0}};\n\nconst char *swc_shader_get(const char *name) {\n    for (int i = 0; swc_shader_table[i].name != 0; i++)\n        if (strcmp(swc_shader_table[i].name, name) == 0)\n            return swc_shader_table[i].text;\n    return 0;\n}\n")
  set(_out "${CMAKE_CURRENT_BINARY_DIR}/swc_shaders.c")
  set(_old "")
  if(EXISTS "${_out}")
    file(READ "${_out}" _old)
  endif()
  if(NOT _old STREQUAL _c) # leave the file alone when nothing changed: no needless recompile
    file(WRITE "${_out}" "${_c}")
  endif()
  set(${out_var} "${_out}" PARENT_SCOPE)
endfunction()
