// Cloudflare Worker + D1 for the arCade online leaderboard. The wire format is specified in
// core/include/arcade/lbnet.h (the C client); src/protocol.ts is its server side.
// Requires wrangler >= 4.36 (the "ratelimits" binding).
{
  "name": "arcade-leaderboard",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "observability": { "enabled": true },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "arcade-leaderboard",
      // from `wrangler d1 create arcade-leaderboard`; an identifier, not a secret
      "database_id": "8cd5c5e6-45d7-4ea0-a6f2-c8fd093f5383",
      "migrations_dir": "migrations"
    }
  ],

  // BEST-EFFORT limits only. Cloudflare counts per machine and syncs lazily; measured on the deployed Worker:
  // exact over one reused connection (59 of 200 allowed at a limit of 60), but almost nothing against 20
  // parallel connections (398 of 400 allowed). They slow down a naive loop and nothing more. The exact
  // protections are in the code: MAX_REGISTRATIONS_PER_HOUR (counted in D1), the score caps, the one row per
  // install and table. namespace_id only has to be unique within the Cloudflare account.
  "ratelimits": [
    { "name": "RL_REGISTER", "namespace_id": "7101", "simple": { "limit": 10, "period": 60 } },
    { "name": "RL_INSTALL", "namespace_id": "7102", "simple": { "limit": 10, "period": 60 } },
    { "name": "RL_SCORES_IP", "namespace_id": "7103", "simple": { "limit": 60, "period": 60 } },
    { "name": "RL_READ", "namespace_id": "7104", "simple": { "limit": 60, "period": 60 } }
  ]
}
