<?xml version="1.0" encoding="utf-8"?>
<!--
  arCade for Android: one NativeActivity and nothing else (no Java or Kotlin, so hasCode="false").
  Android loads libarcade.so (lib_name below) and calls into it; raylib's android_main() then runs main().
  The version (versionCode and versionName) and the SDK levels are not written here: tools/build_apk.sh passes
  them to aapt2, so that the number comes from the release and not from a file that could be forgotten.
  The package name is the app's identity on the phone: scores, the signing key and updates are tied to it, so it
  must not change once people have installed the app (docs/ANDROID.md).
  No <uses-permission>: the Online leaderboard is off in the Android build for now (docs/ANDROID.md: it needs
  android.permission.INTERNET).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="dev.arcade.hub">

    <!-- raylib draws with OpenGL ES 2.0, and the game cannot be played without a touch screen. -->
    <uses-feature android:glEsVersion="0x00020000" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="true" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.Arcade"
        android:appCategory="game"
        android:hasCode="false"
        android:extractNativeLibs="false"
        android:enableOnBackInvokedCallback="false">
        <!-- appCategory game: tells Android this is a game (from targetSdk 36, Android 16 stops honouring a fixed
             orientation on big screens, except for games). extractNativeLibs false: the library runs straight from
             the .apk (stored uncompressed, 16 KB aligned by build_apk.sh). Predictive back off: the Back button
             must reach the game as a key (raylib's KEY_BACK) instead of closing the app; from targetSdk 36 on
             Android treats this opt-out as temporary, which is why the target stays at 35 for now. -->

        <activity
            android:name="android.app.NativeActivity"
            android:label="@string/app_name"
            android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|keyboardHidden|keyboard|navigation|screenSize|smallestScreenSize|screenLayout|density|uiMode"
            android:launchMode="singleTask">
            <meta-data android:name="android.app.lib_name" android:value="arcade" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
