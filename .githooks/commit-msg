#!/bin/sh
# Optional local guard: git config core.hooksPath .githooks
# Rejects commit messages that are not Conventional Commits (the release version is computed from them).
msg="$(head -n 1 "$1")"
case "$msg" in
  Merge*|Revert*|fixup!*|squash!*) exit 0 ;;
esac
if ! printf '%s\n' "$msg" | grep -Eq '^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9_./-]+\))?!?: .+'; then
  echo "Commit message must look like:  type(scope): subject" >&2
  echo "  types: feat fix docs style refactor perf test build ci chore revert   (add ! for breaking changes)" >&2
  echo "  example: feat(echo_maze): add sonar ping" >&2
  exit 1
fi
